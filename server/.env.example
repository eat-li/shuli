# 这个文件是**可选的**。
#
# 不建 .env 项目也能正常启动：数据库是本地 SQLite 文件，端口默认 7788，
# 图片落在本地磁盘——所有需要配置的东西都有一个能用的默认值。
# 只有下面几种情况你才需要它：
#   · 7788 被别的程序占用，想换端口
#   · 想让同一局域网的其它设备访问（务必先看「安全须知」）
#   · 想用阿里云 OSS 存图片，或把 AI 接口配在服务端
#
# 用法：把本文件复制为 server/.env，只写你要改的那几行，其余删掉即可。

# —— 服务 ——
# 端口。启动脚本、停止脚本、vite 代理都从这里读，改一处即可。
# 别选会落进 Windows 保留段的端口：Hyper-V / WSL / Docker 的 NAT 驱动会成段
# 动态保留端口，落进去的端口绑定必报 EACCES。
# 查当前保留段：netsh interface ipv4 show excludedportrange protocol=tcp
# PORT=7788

# 监听地址，默认 127.0.0.1（只有本机能访问）。
# 改成 0.0.0.0 前请确认：本版本没有任何登录鉴权，能连到端口的人就能读写全部数据
# （含试题答案）。局域网/公网使用必须在前面加反向代理并配置访问控制。
# HOST=127.0.0.1

# 额外的跨域来源，逗号分隔。默认不用填：本机 localhost / 127.0.0.1 / 网卡 IP / 主机名
# 这几个地址后端本来就认同源。只有走反向代理用独立域名访问时才需要，例如：
# CORS_ORIGINS=https://shuli.example.com
# 不声明的后果是代理域名下 <script type=module> 被 CORS 拦成 403，页面白屏。
# CORS_ORIGINS=

# 数据库文件位置。相对路径以 server/ 为基准；默认 data/shuli.sqlite。
# DB_FILE=data/shuli.sqlite

# 运行环境：development / production。
# 生产模式下客户端只看到「服务器内部错误」，详细堆栈留在控制台。
# NODE_ENV=production

# —— 请求限流（生产环境默认开启）——
# 只作用于 /api/，静态资源不计入。单人使用基本不会触发。
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# —— 文件存储 ——
# 默认落本地磁盘，不需要任何外部服务。想用阿里云 OSS 就改成 oss 并补齐下面的 OSS_*。
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=data/uploads
# 对外访问前缀：留空则用相对路径 /uploads/...（推荐，换网络环境不会裂图）。
# 只有把文件挂在独立域名/CDN 上时才填，例如 https://cdn.example.com
# STORAGE_PUBLIC_BASE_URL=
# STORAGE_PATH_PREFIX=

# 以下仅在 STORAGE_DRIVER=oss 时需要
# OSS_REGION=oss-cn-chengdu
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_BASE_URL=https://your-bucket.oss-cn-chengdu.aliyuncs.com

# —— AI 功能 ——
# 通常不需要在这里配：打开界面「设置 → AI」，填 Key 即可，存在数据库里。
# 这里只配「服务端统一提供 Key」的场景（多台设备共用一份）。
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# 允许前端选择的接口地址，逗号分隔
# AI_ALLOWED_BASE_URLS=https://api.deepseek.com/v1,https://api.openai.com/v1
# 放行任意接口地址（自建 / 中转 / 本地 Ollama）。
# 默认 false：只允许上面的白名单，避免服务端被诱导请求任意地址（SSRF）。
# AI_ALLOW_ANY_BASE_URL=false
# AI_STREAM_IDLE_MS=60000
# AI_STREAM_MAX_MS=600000
# AI 组卷超时；超时后自动降级为规则组卷
# AI_COMPOSE_TIMEOUT_MS=90000
