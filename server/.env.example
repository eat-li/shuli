# 复制为 .env 后按需修改。**不填也能跑**（全部有默认值）——
# 本文件只是把可调项列出来，方便你知道有哪些开关。
#
# 注意：本版本是单用户自托管，**没有登录鉴权**。
# 因此默认只监听 127.0.0.1；改成 0.0.0.0 前请先想清楚谁能连到这台机器。

# 服务端口。启动脚本与 vite 代理都从这里读，不要另处硬编码。
# 别选会落进 Windows 保留段的端口：Hyper-V / WSL / Docker 的 NAT 驱动会成段
# 动态保留端口，落进去的端口绑定必报 EACCES。
# 查当前保留段：netsh interface ipv4 show excludedportrange protocol=tcp
PORT=7788

# 监听地址。默认只允许本机访问。
# 需要局域网/公网访问时改成 0.0.0.0，但**必须**在前面加反向代理与访问控制，
# 否则任何能连到该端口的人都能读写你的题库（含答案）。
HOST=127.0.0.1

# 运行环境：development / production
NODE_ENV=development

# CORS 白名单（逗号分隔）；开发时 Vite 走代理，同源，通常不用改。
# 例：CORS_ORIGINS=http://localhost:5173,https://teacher.example.com
CORS_ORIGINS=*

# 未传分页参数的列表接口最多返回多少条，避免误拉全表
DEFAULT_LIST_LIMIT=1000

# 进程内缓存最大条目数
CACHE_MAX_ENTRIES=200

# —— 建表与索引 ——
# DB_SYNC            auto(默认)=缺表才建 | true=总是 sync | false=跳过
# DB_ENSURE_INDEXES  true 才在启动时补建索引（默认关闭；索引由迁移 001 管理）
DB_SYNC=auto
DB_ENSURE_INDEXES=false

# —— 数据库连接（当前版本仅支持 MySQL；SQLite 支持在开发中）——
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shuli
DB_USER=root
DB_PASS=
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_RETRY_MAX=2

# —— 请求限流（生产环境默认开启；本地可用 RATE_LIMIT_ENABLED=true 手动测试）——
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# —— 文件存储 ——
# 默认落本地磁盘，不需要任何外部服务。想用阿里云 OSS 就把驱动改成 oss 并补齐下面的 OSS_*。
STORAGE_DRIVER=local
# 本地落盘目录（相对路径以 server/ 为基准；也可以用绝对路径）
STORAGE_LOCAL_DIR=data/uploads
# 对外访问前缀：留空则用相对路径 /uploads/...（推荐）。
# 只有把文件挂在独立域名/CDN 上时才填，例如 https://cdn.example.com
STORAGE_PUBLIC_BASE_URL=
# 对象 key 前缀，形如 <前缀>/questions/2026-11-05/xxx.png；留空表示不加前缀
STORAGE_PATH_PREFIX=

# 以下仅在 STORAGE_DRIVER=oss 时需要
OSS_REGION=oss-cn-chengdu
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_BASE_URL=https://your-bucket.oss-cn-chengdu.aliyuncs.com

# —— AI 功能（全部可选：不配也能用题库、组卷、成绩、讲义，只是没有 AI 辅助）——
# 默认走 DeepSeek 的 OpenAI 兼容接口
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 允许前端选择的接口地址，逗号分隔；内置允许 DeepSeek 与 OpenAI 官方地址
AI_ALLOWED_BASE_URLS=https://api.deepseek.com/v1,https://api.openai.com/v1
# 放行任意接口地址（自建 / 中转 / 本地 Ollama）。
# 默认 false：只允许上面的白名单，避免服务端被诱导请求任意地址（SSRF）。
AI_ALLOW_ANY_BASE_URL=false
# 流式生成的空闲超时与硬上限（毫秒）
AI_STREAM_IDLE_MS=60000
AI_STREAM_MAX_MS=600000
# AI 组卷超时；超时后自动降级为规则组卷
AI_COMPOSE_TIMEOUT_MS=90000
